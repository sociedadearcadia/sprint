rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // Integrante: aparelho que já digitou a senha do clube
    function membro() {
      return request.auth != null
        && exists(/databases/$(database)/documents/membros/$(request.auth.uid));
    }

    // Senha do clube: o ID do documento em "chaves" é a senha (em minúsculas). Ninguém lê pelo site.
    match /chaves/{chave} { allow read, write: if false; }
    // Cada aparelho se registra uma vez com a senha certa
    match /membros/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['chave','em'])
        && request.resource.data.chave is string
        && exists(/databases/$(database)/documents/chaves/$(request.resource.data.chave));
      allow update, delete: if false;
    }

    // Ranking: todas leem; cada leitora só escreve no próprio documento
    match /leitoras/{uid} {
      allow read: if membro();
      allow write: if membro() && request.auth.uid == uid
                   && request.resource.data.nome is string
                   && request.resource.data.nome.size() <= 30;
    }
    // Sprint coletivo: um por vez. Qualquer leitora começa um novo quando não há outro em andamento;
    // quem começou pode cancelar.
    match /coletivo/atual {
      allow read: if membro();
      allow write: if membro()
        && request.resource.data.startAt is int
        && request.resource.data.read is int && request.resource.data.read >= 1 && request.resource.data.read <= 180
        && request.resource.data.prosa is int && request.resource.data.prosa >= 0 && request.resource.data.prosa <= 60
        && request.resource.data.por is string && request.resource.data.por.size() <= 30
        && request.resource.data.dono == request.auth.uid
        && (resource == null
            || resource.data.dono == request.auth.uid
            || resource.data.startAt + (resource.data.read + resource.data.prosa) * 60000 < request.time.toMillis());
    }
    // Quem está no sprint coletivo: cada leitora só mexe na própria presença
    match /coletivo/atual/quem/{uid} {
      allow read: if membro();
      allow write: if membro() && request.auth.uid == uid
                   && (request.resource == null
                       || (request.resource.data.nome is string && request.resource.data.nome.size() <= 30));
    }
    // Lista de espera (site do clube): qualquer pessoa envia; só administradoras leem
    match /interessadas/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['nome','nascimento','whatsapp','instagram','cidade','ritmo','generos','favoritos','clube','expectativas','origem','consentimento','criadoEm'])
        && str(request.resource.data.nome, 3, 120)
        && str(request.resource.data.nascimento, 10, 10)
        && str(request.resource.data.whatsapp, 10, 20)
        && str(request.resource.data.instagram, 0, 60)
        && str(request.resource.data.cidade, 1, 80)
        && str(request.resource.data.ritmo, 1, 40)
        && request.resource.data.generos is list && request.resource.data.generos.size() <= 12
        && str(request.resource.data.favoritos, 0, 1000)
        && str(request.resource.data.clube, 1, 40)
        && str(request.resource.data.expectativas, 0, 1500)
        && str(request.resource.data.origem, 1, 60)
        && request.resource.data.consentimento == true
        && request.resource.data.criadoEm == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    // Atualização de leitura: livro do mês (só a administração cria/corrige; todas veem)
    match /leituras/{livro} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['titulo','autor','mes','capa','inicio'])
        && str(request.resource.data.titulo, 1, 120)
        && str(request.resource.data.autor, 0, 120)
        && str(request.resource.data.mes, 0, 40)
        && str(request.resource.data.capa, 0, 400000);
      allow delete: if isAdmin();
      // Porcentagem de cada integrante (um documento por nome)
      match /progresso/{nome} {
        allow read: if membro() || isAdmin();
        allow create, update: if (membro() || isAdmin())
          && request.resource.data.keys().hasOnly(['nome','pct','em'])
          && str(request.resource.data.nome, 1, 30)
          && request.resource.data.pct is int
          && request.resource.data.pct >= 0 && request.resource.data.pct <= 100
          && request.resource.data.em == request.time;
        allow delete: if isAdmin();
      }
    }
    // Sorteio do livro do mês: só a administração
    match /sorteios/{id} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }
    // Agenda do clube: só a administração cria e edita encontros; integrantes veem
    match /eventos/{ev} {
      allow read: if membro() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['titulo','tipo','tema','data','hora','local','endereco','descricao','criadoEm'])
        && str(request.resource.data.titulo, 1, 80)
        && str(request.resource.data.tipo, 0, 40)
        && request.resource.data.tema in ['livro','csi','natal','especial']
        && request.resource.data.data is string && request.resource.data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(request.resource.data.hora, 0, 5)
        && str(request.resource.data.local, 0, 80)
        && str(request.resource.data.endereco, 0, 160)
        && str(request.resource.data.descricao, 0, 600)
        && request.resource.data.criadoEm is timestamp;
      allow delete: if isAdmin();
      // Confirmação de presença (um documento por nome)
      match /presencas/{nome} {
        allow read: if membro() || isAdmin();
        allow create, update: if (membro() || isAdmin())
          && request.resource.data.keys().hasOnly(['nome','resp','em'])
          && str(request.resource.data.nome, 1, 30)
          && request.resource.data.resp in ['vou','talvez','nao']
          && request.resource.data.em == request.time;
        allow delete: if membro() || isAdmin();
      }
    }
    // Livros sugeridos para o sorteio da leitura oficial (romantasia e fantasia)
    // Abrir/fechar as sugestões: só a administração muda; integrantes leem
    match /config/sugestoes {
      allow read: if membro() || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['aberto','ate','proxima','semeado'])
        && request.resource.data.get('aberto', false) is bool
        && str(request.resource.data.get('ate', ''), 0, 10)
        && str(request.resource.data.get('proxima', ''), 0, 10);
    }
    // LCs extras: cada uma tem a sua lista de sugestões (só a administração cria e muda)
    match /config/lcs {
      allow read: if membro() || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['itens'])
        && request.resource.data.itens is map
        && request.resource.data.itens.size() <= 20;
    }
    function lcAberta(id) {
      let itens = get(/databases/$(database)/documents/config/lcs).data.get('itens', {});
      return id in itens
        && itens[id].get('aberto', false) == true
        && itens[id].get('ativa', true) == true;
    }
    function sugestoesAbertas() {
      return get(/databases/$(database)/documents/config/sugestoes).data.get('aberto', false) == true;
    }
    function livroOk(d) {
      return d.keys().hasOnly(['titulo','autor','genero','obs','nome','uid','status','motivo','criadoEm','lista'])
        && str(d.titulo, 1, 120)
        && str(d.get('autor', ''), 0, 120)
        && str(d.get('lista', 'oficial'), 1, 40)
        && ((d.get('lista', 'oficial') == 'oficial' && d.genero in ['romantasia','fantasia'])
            || (d.get('lista', 'oficial') != 'oficial' && d.genero == ''))
        && str(d.get('obs', ''), 0, 400)
        && str(d.get('nome', ''), 0, 30)
        && str(d.get('motivo', ''), 0, 120)
        && d.status in ['lista','pendente','recusada'];
    }
    match /sugestoes/{id} {
      // integrantes veem a lista e as próprias sugestões; a administração vê tudo
      allow read: if isAdmin()
        || (membro() && (resource.data.status == 'lista' || resource.data.uid == request.auth.uid));
      allow create: if (isAdmin() && livroOk(request.resource.data))
        || (membro()
            && (request.resource.data.get('lista', 'oficial') == 'oficial' ? sugestoesAbertas() : lcAberta(request.resource.data.lista))
            && livroOk(request.resource.data)
            && request.resource.data.keys().hasOnly(['titulo','autor','genero','obs','nome','uid','status','criadoEm','lista'])
            && request.resource.data.status == 'pendente'
            && request.resource.data.uid == request.auth.uid
            && str(request.resource.data.nome, 1, 30)
            && str(request.resource.data.autor, 1, 120)
            && request.resource.data.criadoEm == request.time);
      allow update: if isAdmin() && livroOk(request.resource.data);
      allow delete: if isAdmin();
    }
    // Lista pública da leitura oficial (página /lista-de-espera): só título, autora e gênero.
    // Qualquer pessoa lê; só a administração grava (a página /livros/admin atualiza sozinha).
    // Nomes de quem sugeriu, observações e status das sugestões não entram aqui.
    match /publico/livros {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['itens','em'])
        && request.resource.data.itens is list
        && request.resource.data.itens.size() <= 1000;
    }
    // Ideias de encontros (oficinas e encontros extras): integrantes enviam; só a administração aprova
    match /ideias/{id} {
      // cada aparelho vê só as próprias ideias; a administração vê tudo
      allow read: if isAdmin() || (membro() && resource.data.uid == request.auth.uid);
      allow create: if membro()
        && request.resource.data.keys().hasOnly(['nome','tipo','titulo','explicacao','organizacao','compromisso','status','uid','criadoEm'])
        && str(request.resource.data.nome, 1, 30)
        && request.resource.data.tipo in ['oficina','extra']
        && str(request.resource.data.titulo, 1, 100)
        && str(request.resource.data.explicacao, 1, 2000)
        && str(request.resource.data.organizacao, 1, 3000)
        && request.resource.data.compromisso == true
        && request.resource.data.status == 'pendente'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.criadoEm == request.time;
      // a administração só muda a situação e o recado
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','nota'])
        && request.resource.data.status in ['pendente','aprovada','recusada']
        && str(request.resource.data.get('nota', ''), 0, 600);
      allow delete: if isAdmin();
    }
    // Sugestões para as redes sociais: cada aparelho vê só as próprias; a administração vê tudo
    match /redes/{id} {
      allow read: if isAdmin() || (membro() && resource.data.uid == request.auth.uid);
      allow create: if membro()
        && request.resource.data.keys().hasOnly(['nome','tipo','descricao','link','imagem','status','uid','criadoEm'])
        && str(request.resource.data.nome, 1, 30)
        && request.resource.data.tipo in ['post','trend','resenha','foto','outro']
        && str(request.resource.data.descricao, 1, 2000)
        && str(request.resource.data.get('link', ''), 0, 500)
        && str(request.resource.data.get('imagem', 'data:image/x;base64,A'), 20, 900000)
        && request.resource.data.get('imagem', 'data:image/x;base64,A').matches('data:image/[a-z]+;base64,[A-Za-z0-9+/=]+')
        && request.resource.data.status == 'recebida'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.criadoEm == request.time;
      // a administração só muda a situação e o recado
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','nota'])
        && request.resource.data.status in ['recebida','aprovada','publicada']
        && str(request.resource.data.get('nota', ''), 0, 600);
      allow delete: if isAdmin();
    }
    // Questionário de confirmação de leitura (um por livro do mês; o ID é o mesmo do livro em "leituras")
    match /questionarios/{livro} {
      allow read: if membro() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['perguntas','aberto','minimo','liberado','em'])
        && request.resource.data.perguntas is list
        && request.resource.data.perguntas.size() >= 1 && request.resource.data.perguntas.size() <= 30
        && request.resource.data.aberto is bool
        && request.resource.data.minimo is int && request.resource.data.minimo >= 0 && request.resource.data.minimo <= 100
        && request.resource.data.liberado is list;
      allow delete: if isAdmin();
      // Gabarito: só a administração vê
      match /gabarito/{doc} {
        allow read, write: if isAdmin();
      }
      // Respostas: uma por nome, enviada uma vez só, com o questionário aberto
      match /respostas/{nome} {
        allow list: if isAdmin();
        allow get: if isAdmin()
          || (membro() && (resource == null || resource.data.uid == request.auth.uid));
        allow create: if membro()
          && get(/databases/$(database)/documents/questionarios/$(livro)).data.aberto == true
          && request.resource.data.keys().hasOnly(['nome','r','uid','em'])
          && str(request.resource.data.nome, 1, 30)
          && request.resource.data.r is list
          && request.resource.data.r.size() == get(/databases/$(database)/documents/questionarios/$(livro)).data.perguntas.size()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.em == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
    // Artes do clube: integrantes veem e baixam; só a administração adiciona, muda e apaga.
    // O arquivo fica dividido em partes de até 900 KB (limite do Firestore é 1 MB por documento).
    match /artes/{id} {
      allow read: if membro() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['nome','categoria','tipo','arquivo','tamanho','partes','miniatura','largura','altura','criadoEm'])
        && str(request.resource.data.nome, 1, 100)
        && str(request.resource.data.categoria, 1, 60)
        && str(request.resource.data.tipo, 3, 100)
        && str(request.resource.data.arquivo, 1, 160)
        && request.resource.data.tamanho is int && request.resource.data.tamanho > 0 && request.resource.data.tamanho <= 20000000
        && request.resource.data.partes is int && request.resource.data.partes >= 1 && request.resource.data.partes <= 25
        && (!('miniatura' in request.resource.data) || str(request.resource.data.miniatura, 0, 200000));
      allow delete: if isAdmin();
      match /partes/{n} {
        allow read: if membro() || isAdmin();
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is bytes;
        allow delete: if isAdmin();
      }
    }
    // Votação do livro do mês: a administração cria (3 livros e as datas); integrantes veem
    match /votacoes/{vt} {
      allow read: if membro() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['titulo','opcoes','abre','fecha','encontro','abreEm','fechaEm','criadoEm'])
        && str(request.resource.data.titulo, 1, 80)
        && request.resource.data.opcoes is list && request.resource.data.opcoes.size() == 3
        && request.resource.data.abre.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.encontro.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.abreEm is timestamp
        && request.resource.data.fechaEm is timestamp
        && request.resource.data.abreEm < request.resource.data.fechaEm;
      allow delete: if isAdmin();
      // Votos: um por nome (o ID é o nome), só com a votação aberta, sem trocar depois.
      // Integrantes não leem os votos das outras (o resultado só aparece para a administração).
      match /votos/{nome} {
        allow list: if isAdmin();
        allow get: if isAdmin()
          || (membro() && (resource == null || resource.data.uid == request.auth.uid));
        allow create: if membro()
          && request.time >= get(/databases/$(database)/documents/votacoes/$(vt)).data.abreEm
          && request.time <= get(/databases/$(database)/documents/votacoes/$(vt)).data.fechaEm
          && request.resource.data.keys().hasOnly(['nome','opcao','uid','em'])
          && str(request.resource.data.nome, 1, 30)
          && request.resource.data.opcao is int
          && request.resource.data.opcao >= 0
          && request.resource.data.opcao < get(/databases/$(database)/documents/votacoes/$(vt)).data.opcoes.size()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.em == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
      // Votos presenciais digitados pela administração (só ela vê)
      match /privado/{doc} {
        allow read, write: if isAdmin();
      }
    }
    // Bingo: desafios e abrir/fechar o envio de provas (só a administração muda; integrantes leem)
    match /config/bingo {
      // a tabela só aparece para as integrantes depois que a administração libera
      allow read: if isAdmin() || (membro() && resource.data.get('visivel', false) == true);
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['titulo','edicao','desafios','aberto','ate','visivel','resumo','regras'])
        && request.resource.data.get('visivel', false) is bool
        && str(request.resource.data.get('resumo', ''), 0, 3000)
        && str(request.resource.data.get('regras', ''), 0, 9000)
        && str(request.resource.data.titulo, 1, 60)
        && str(request.resource.data.edicao, 1, 40)
        && request.resource.data.desafios is list && request.resource.data.desafios.size() <= 60
        && request.resource.data.aberto is bool
        && str(request.resource.data.ate, 0, 10);
    }
    // Ranking do bingo: só quantos desafios aprovados cada uma tem (a administração atualiza)
    match /config/bingoRanking {
      allow read: if membro() || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['edicao','itens','em'])
        && request.resource.data.itens is map && request.resource.data.itens.size() <= 60;
    }
    function bingo() { return get(/databases/$(database)/documents/config/bingo).data; }
    // Bingo: cada integrante tem a própria cartela. O ID da cartela é um código secreto feito do nome
    // e de 4 números que só ela sabe; sem ele, ninguém abre a cartela (não dá para listar).
    // "pessoas" só diz se o nome já criou o código (para não criarem outro por cima).
    match /pessoas/{nome} {
      allow get: if membro() || isAdmin();
      allow list: if isAdmin();
      allow create: if membro()
        && request.resource.data.keys().hasOnly(['em'])
        && request.resource.data.em == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /cartelas/{c} {
      allow get: if membro() || isAdmin();
      allow list: if isAdmin();
      // cria junto com "pessoas" (um código por nome)
      allow create: if membro()
        && c.size() == 64
        && request.resource.data.keys().hasOnly(['nome','slug','marcadas','edicao','em'])
        && str(request.resource.data.nome, 1, 30)
        && str(request.resource.data.slug, 1, 40)
        && !exists(/databases/$(database)/documents/pessoas/$(request.resource.data.slug))
        && existsAfter(/databases/$(database)/documents/pessoas/$(request.resource.data.slug))
        && request.resource.data.marcadas is list && request.resource.data.marcadas.size() == 0;
      // a integrante só muda as próprias marcações
      allow update: if membro()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marcadas','edicao','em'])
        && request.resource.data.marcadas is list && request.resource.data.marcadas.size() <= 60
        && str(request.resource.data.edicao, 0, 40);
      allow delete: if isAdmin();

      // Provas do bingo: a integrante manda o print; só a administração aprova
      match /provas/{id} {
        allow get, list: if membro() || isAdmin();
        allow create: if membro()
          && bingo().aberto == true
          && bingo().get('visivel', false) == true
          && request.resource.data.keys().hasOnly(['edicao','nome','desafio','desafioTexto','livro','obs','fotos','status','criadoEm'])
          && request.resource.data.edicao == bingo().edicao
          && request.resource.data.nome == get(/databases/$(database)/documents/cartelas/$(c)).data.nome
          && str(request.resource.data.desafio, 1, 40)
          && str(request.resource.data.desafioTexto, 1, 200)
          && str(request.resource.data.get('livro', ''), 0, 120)
          && str(request.resource.data.obs, 0, 400)
          && request.resource.data.fotos is int && request.resource.data.fotos >= 1 && request.resource.data.fotos <= 3
          && request.resource.data.status == 'pendente'
          && request.resource.data.criadoEm == request.time
          && existsAfter(/databases/$(database)/documents/cartelas/$(c)/provas/$(id)/img/0);
        // a administração só muda a situação e o recado
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','nota'])
          && request.resource.data.status in ['pendente','aprovada','recusada']
          && str(request.resource.data.get('nota', ''), 0, 600);
        // quem mandou pode cancelar enquanto está aguardando
        allow delete: if isAdmin() || (membro() && resource.data.status == 'pendente');

        // Imagens da prova (separadas, para a lista ficar leve)
        match /img/{n} {
          allow get: if membro() || isAdmin();
          allow list: if false;
          allow create: if membro() && n == '0'
            && request.resource.data.keys().hasOnly(['imgs'])
            && request.resource.data.imgs is list
            && request.resource.data.imgs.size() == getAfter(/databases/$(database)/documents/cartelas/$(c)/provas/$(id)).data.fotos;
          allow update: if false;
          allow delete: if isAdmin()
            || (membro() && get(/databases/$(database)/documents/cartelas/$(c)/provas/$(id)).data.status == 'pendente');
        }
      }
    }
    // A administração lê as provas de todas as cartelas de uma vez
    match /{caminho=**}/provas/{id} {
      allow read: if isAdmin();
    }
    // Administradoras (documento criado à mão no console do Firebase)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
