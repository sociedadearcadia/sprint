rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // Integrante: aparelho que já digitou a senha do clube
    function membro() {
      return request.auth != null
        && exists(/databases/$(database)/documents/membros/$(request.auth.uid));
    }

    // Senha do clube: o ID do documento em "chaves" é a senha (em minúsculas). Ninguém lê pelo site.
    match /chaves/{chave} { allow read, write: if false; }
    // Cada aparelho se registra uma vez com a senha certa
    match /membros/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['chave','em'])
        && request.resource.data.chave is string
        && exists(/databases/$(database)/documents/chaves/$(request.resource.data.chave));
      allow update, delete: if false;
    }

    // Ranking: todas leem; cada leitora só escreve no próprio documento
    match /leitoras/{uid} {
      allow read: if membro();
      allow write: if membro() && request.auth.uid == uid
                   && request.resource.data.nome is string
                   && request.resource.data.nome.size() <= 30;
    }
    // Sprint coletivo: um por vez. Qualquer leitora começa um novo quando não há outro em andamento;
    // quem começou pode cancelar.
    match /coletivo/atual {
      allow read: if membro();
      allow write: if membro()
        && request.resource.data.startAt is int
        && request.resource.data.read is int && request.resource.data.read >= 1 && request.resource.data.read <= 180
        && request.resource.data.prosa is int && request.resource.data.prosa >= 0 && request.resource.data.prosa <= 60
        && request.resource.data.por is string && request.resource.data.por.size() <= 30
        && request.resource.data.dono == request.auth.uid
        && (resource == null
            || resource.data.dono == request.auth.uid
            || resource.data.startAt + (resource.data.read + resource.data.prosa) * 60000 < request.time.toMillis());
    }
    // Quem está no sprint coletivo: cada leitora só mexe na própria presença
    match /coletivo/atual/quem/{uid} {
      allow read: if membro();
      allow write: if membro() && request.auth.uid == uid
                   && (request.resource == null
                       || (request.resource.data.nome is string && request.resource.data.nome.size() <= 30));
    }
    // Lista de espera (site do clube): qualquer pessoa envia; só administradoras leem
    match /interessadas/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['nome','nascimento','whatsapp','instagram','cidade','ritmo','generos','favoritos','clube','expectativas','origem','consentimento','criadoEm'])
        && str(request.resource.data.nome, 3, 120)
        && str(request.resource.data.nascimento, 10, 10)
        && str(request.resource.data.whatsapp, 10, 20)
        && str(request.resource.data.instagram, 0, 60)
        && str(request.resource.data.cidade, 1, 80)
        && str(request.resource.data.ritmo, 1, 40)
        && request.resource.data.generos is list && request.resource.data.generos.size() <= 12
        && str(request.resource.data.favoritos, 0, 1000)
        && str(request.resource.data.clube, 1, 40)
        && str(request.resource.data.expectativas, 0, 1500)
        && str(request.resource.data.origem, 1, 60)
        && request.resource.data.consentimento == true
        && request.resource.data.criadoEm == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    // Atualização de leitura: livro do mês (só a administração cria/corrige; todas veem)
    match /leituras/{livro} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['titulo','autor','mes','capa','inicio'])
        && str(request.resource.data.titulo, 1, 120)
        && str(request.resource.data.autor, 0, 120)
        && str(request.resource.data.mes, 0, 40)
        && str(request.resource.data.capa, 0, 400000);
      allow delete: if isAdmin();
      // Porcentagem de cada integrante (um documento por nome)
      match /progresso/{nome} {
        allow read: if membro() || isAdmin();
        allow create, update: if (membro() || isAdmin())
          && request.resource.data.keys().hasOnly(['nome','pct','em'])
          && str(request.resource.data.nome, 1, 30)
          && request.resource.data.pct is int
          && request.resource.data.pct >= 0 && request.resource.data.pct <= 100
          && request.resource.data.em == request.time;
        allow delete: if isAdmin();
      }
    }
    // Sorteio do livro do mês: só a administração
    match /sorteios/{id} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }
    // Agenda do clube: só a administração cria e edita encontros; integrantes veem
    match /eventos/{ev} {
      allow read: if membro() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['titulo','tipo','tema','data','hora','local','endereco','descricao','criadoEm'])
        && str(request.resource.data.titulo, 1, 80)
        && str(request.resource.data.tipo, 0, 40)
        && request.resource.data.tema in ['livro','csi','natal','especial']
        && request.resource.data.data is string && request.resource.data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(request.resource.data.hora, 0, 5)
        && str(request.resource.data.local, 0, 80)
        && str(request.resource.data.endereco, 0, 160)
        && str(request.resource.data.descricao, 0, 600)
        && request.resource.data.criadoEm is timestamp;
      allow delete: if isAdmin();
      // Confirmação de presença (um documento por nome)
      match /presencas/{nome} {
        allow read: if membro() || isAdmin();
        allow create, update: if (membro() || isAdmin())
          && request.resource.data.keys().hasOnly(['nome','resp','em'])
          && str(request.resource.data.nome, 1, 30)
          && request.resource.data.resp in ['vou','talvez','nao']
          && request.resource.data.em == request.time;
        allow delete: if membro() || isAdmin();
      }
    }
    // Administradoras (documento criado à mão no console do Firebase)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
