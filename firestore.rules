rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // Conselho: conta Google cujo e-mail está na coleção "conselho" (a administração adiciona e tira pelo painel /admin)
    function isConselho() {
      return request.auth != null
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '') != ''
        && request.auth.token.get('email_verified', false) == true
        && exists(/databases/$(database)/documents/conselho/$(request.auth.token.email.lower()));
    }
    // Áreas que o conselho também administra: agenda, ideias, livros sugeridos, redes, artes e bingo
    function gestao() { return isAdmin() || isConselho(); }
    // Integrante: aparelho que já digitou a senha do clube
    function membro() {
      return request.auth != null
        && exists(/databases/$(database)/documents/membros/$(request.auth.uid));
    }

    // Senha do clube: o ID do documento em "chaves" é a senha (em minúsculas). Ninguém lê pelo site.
    match /chaves/{chave} { allow read, write: if false; }
    // Cada aparelho se registra uma vez com a senha certa
    match /membros/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['chave','em'])
        && request.resource.data.chave is string
        && exists(/databases/$(database)/documents/chaves/$(request.resource.data.chave));
      // turma online: a administração aprova (cria) e remove o acesso de cada conta Google
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['email','nome','em','aprovadoEm'])
        && str(request.resource.data.email, 3, 200);
      allow update: if false;
      allow delete: if isAdmin();
    }
    // Turma online: pedido de acesso feito com a conta Google (a administração aprova em /online/admin/acesso/)
    match /pedidosAcesso/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.get('email', '') is string && request.auth.token.get('email', '') != ''
        && request.resource.data.keys().hasOnly(['email','nome','em'])
        && request.resource.data.email == request.auth.token.email
        && str(request.resource.data.nome, 0, 120)
        && request.resource.data.em == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // Histórico pessoal de sprints ("Seus sprints"), guardado pelo nome escolhido:
    // aparece igual em todos os aparelhos e navegadores da mesma integrante (inclui os da Biblioteca de Hogwarts)
    match /historico/{nome}/s/{id} {
      allow read: if membro();
      allow create, update: if membro() && nome.size() <= 40 && id.size() <= 40
                   && request.resource.data.keys().hasOnly(['t', 'min', 'book', 'pages', 'uid', 'nome', 'coletivo', 'com', 'bib'])
                   && request.resource.data.uid == request.auth.uid
                   && request.resource.data.t is number
                   && request.resource.data.min is number
                   && request.resource.data.min >= 0 && request.resource.data.min <= 720
                   && request.resource.data.pages is number
                   && request.resource.data.book is string && request.resource.data.book.size() <= 120
                   && request.resource.data.nome is string && request.resource.data.nome.size() <= 30;
      allow delete: if isAdmin();
    }

    // Ranking: todas leem; cada leitora só escreve no próprio documento
    match /leitoras/{uid} {
      allow read: if membro();
      allow write: if membro() && request.auth.uid == uid
                   && request.resource.data.nome is string
                   && request.resource.data.nome.size() <= 30;
    }
    // Sprint coletivo: um por vez, com várias rodadas de leitura + prosa (ciclos). Qualquer leitora começa um novo quando não há outro em andamento;
    // quem começou pode cancelar.
    // Uso da sala de vídeo no mês (estimativa do plano gratuito do Daily): cada aparelho soma até 10 min por vez
    match /salaUso/{mes} {
      allow read: if membro() || isAdmin();
      allow create: if membro() && request.resource.data.keys().hasOnly(['min'])
        && request.resource.data.min is int && request.resource.data.min >= 0 && request.resource.data.min <= 10;
      allow update: if membro() && request.resource.data.keys().hasOnly(['min'])
        && request.resource.data.min is int && request.resource.data.min >= resource.data.min
        && request.resource.data.min <= resource.data.min + 10;
      // a administração acerta o total com o número do painel do Daily
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['min'])
        && request.resource.data.min is int && request.resource.data.min >= 0;
    }
    match /coletivo/atual {
      allow read: if membro();
      allow write: if membro()
        && request.resource.data.startAt is int
        && request.resource.data.read is int && request.resource.data.read >= 1 && request.resource.data.read <= 180
        && request.resource.data.prosa is int && request.resource.data.prosa >= 0 && request.resource.data.prosa <= 60
        && request.resource.data.por is string && request.resource.data.por.size() <= 30
        && request.resource.data.get('ciclos', 1) is int
        && request.resource.data.get('ciclos', 1) >= 1 && request.resource.data.get('ciclos', 1) <= 12
        && request.resource.data.dono == request.auth.uid
        && (resource == null
            || resource.data.dono == request.auth.uid
            || resource.data.startAt + (resource.data.read + resource.data.prosa) * 60000 * resource.data.get('ciclos', 1) < request.time.toMillis()
            || resource.data.get('fim', 9000000000000000) < request.time.toMillis());
      // quando a última pessoa sai, qualquer integrante marca o fim do coletivo
      allow update: if membro()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fim'])
        && request.resource.data.fim is int && request.resource.data.fim <= request.time.toMillis() + 60000;
    }
    // Minutos de cada leitora no sprint coletivo (para o stories da administração):
    // cada uma só registra os próprios minutos; só a administração lê; ninguém altera depois
    match /coletivoLido/{id} {
      allow read, delete: if isAdmin();
      allow create: if membro() && request.resource.data.keys().hasOnly(['nome','uid','min','startAt','em'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 30
        && request.resource.data.min is int && request.resource.data.min >= 1 && request.resource.data.min <= 720
        && request.resource.data.startAt is int && request.resource.data.em is int;
      allow update: if false;
    }
    // Quem está online no sprint: cada leitora só mexe no próprio aviso de online
    match /online/{uid} {
      allow read: if membro() || isAdmin();
      allow delete: if membro() && request.auth.uid == uid;
      allow create, update: if membro() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome','em','modo','ate'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 30
        && request.resource.data.em is int && request.resource.data.ate is int
        && request.resource.data.modo in ['site','lendo','coletivo'];
    }
    // Chamar para ler junto: só quem foi chamada lê o chamado (e apaga depois de ver)
    match /chamados/{id} {
      allow read: if membro() && resource.data.para == request.auth.uid;
      allow create: if membro() && request.resource.data.keys().hasOnly(['de','deUid','para','texto','em'])
        && request.resource.data.deUid == request.auth.uid
        && request.resource.data.de is string && request.resource.data.de.size() <= 30
        && request.resource.data.para is string && request.resource.data.para.size() <= 128
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 140
        && request.resource.data.em is int;
      allow delete: if membro() && (resource.data.para == request.auth.uid || resource.data.deUid == request.auth.uid);
      allow update: if false;
    }
    // Chat do sprint coletivo: integrantes leem e escrevem; cada uma apaga as próprias; a administração apaga qualquer uma
    match /coletivo/atual/chat/{id} {
      allow read: if membro() || isAdmin();
      // fig (opcional) = nome da figurinha do arquivo figurinhas/<fig>.webp
      allow create: if membro() && request.resource.data.keys().hasOnly(['nome','texto','uid','startAt','em','fig'])
        && (!('fig' in request.resource.data) || (request.resource.data.fig is string && request.resource.data.fig.matches('^[a-z0-9-]{1,40}$')))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 30
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 300
        && request.resource.data.startAt is int && request.resource.data.em is int;
      allow delete: if (membro() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if false;
    }
    // Quem está no sprint coletivo: cada leitora só mexe na própria presença
    match /coletivo/atual/quem/{uid} {
      allow read: if membro() || isAdmin();
      // a administração pode tirar quem esqueceu de sair do coletivo
      allow delete: if isAdmin();
      allow write: if membro() && request.auth.uid == uid
                   && (request.resource == null
                       || (request.resource.data.nome is string && request.resource.data.nome.size() <= 30));
    }
    // Lista de espera (site do clube): qualquer pessoa envia; administração e conselho leem; só a administração apaga
    match /interessadas/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['nome','nascimento','whatsapp','instagram','modalidade','cidade','ritmo','generos','favoritos','clube','expectativas','origem','consentimento','criadoEm'])
        && request.resource.data.get('modalidade', 'presencial') in ['presencial', 'online']
        && str(request.resource.data.nome, 3, 120)
        && str(request.resource.data.nascimento, 10, 10)
        && str(request.resource.data.whatsapp, 10, 20)
        && str(request.resource.data.instagram, 0, 60)
        && str(request.resource.data.cidade, 1, 80)
        && str(request.resource.data.ritmo, 1, 40)
        && request.resource.data.generos is list && request.resource.data.generos.size() <= 12
        && str(request.resource.data.favoritos, 0, 1000)
        && str(request.resource.data.clube, 1, 40)
        && str(request.resource.data.expectativas, 0, 1500)
        && str(request.resource.data.origem, 1, 60)
        && request.resource.data.consentimento == true
        && request.resource.data.criadoEm == request.time;
      allow read: if gestao();
      allow delete: if isAdmin();
      allow update: if false;
    }
    // Atualização de leitura: livro do mês (só a administração cria/corrige; todas veem)
    match /leituras/{livro} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['titulo','autor','mes','capa','inicio'])
        && str(request.resource.data.titulo, 1, 120)
        && str(request.resource.data.autor, 0, 120)
        && str(request.resource.data.mes, 0, 40)
        && str(request.resource.data.capa, 0, 400000);
      allow delete: if isAdmin();
      // Porcentagem de cada integrante (um documento por nome)
      match /progresso/{nome} {
        allow read: if membro() || isAdmin();
        allow create, update: if (membro() || isAdmin())
          && request.resource.data.keys().hasOnly(['nome','pct','em'])
          && str(request.resource.data.nome, 1, 30)
          && request.resource.data.pct is int
          && request.resource.data.pct >= 0 && request.resource.data.pct <= 100
          && request.resource.data.em == request.time;
        allow delete: if isAdmin();
      }
      // Estante do clube: nota de 1 a 5 de cada integrante (um documento por nome; todas veem só a média)
      match /avaliacoes/{nome} {
        allow read: if membro() || isAdmin();
        allow create: if membro()
          && request.resource.data.keys().hasOnly(['nome','nota','uid','em'])
          && str(request.resource.data.nome, 1, 30)
          && request.resource.data.nota is int
          && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.em == request.time;
        // só o mesmo aparelho muda a própria nota
        allow update: if membro()
          && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['nome','nota','uid','em'])
          && request.resource.data.nome == resource.data.nome
          && request.resource.data.nota is int
          && request.resource.data.nota >= 1 && request.resource.data.nota <= 5
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.em == request.time;
        allow delete: if isAdmin();
      }
    }
    // Sorteio do livro do mês: só a administração
    match /sorteios/{id} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }
    // Agenda do clube: só a administração cria e edita encontros; integrantes veem
    match /eventos/{ev} {
      allow read: if membro() || gestao();
      allow create, update: if gestao()
        && request.resource.data.keys().hasOnly(['titulo','tipo','tema','data','hora','local','endereco','descricao','criadoEm'])
        && str(request.resource.data.titulo, 1, 80)
        && str(request.resource.data.tipo, 0, 40)
        && request.resource.data.tema in ['livro','csi','natal','especial']
        && request.resource.data.data is string && request.resource.data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(request.resource.data.hora, 0, 5)
        && str(request.resource.data.local, 0, 80)
        && str(request.resource.data.endereco, 0, 160)
        && str(request.resource.data.descricao, 0, 600)
        && request.resource.data.criadoEm is timestamp;
      allow delete: if gestao();
      // Confirmação de presença (um documento por nome)
      match /presencas/{nome} {
        allow read: if membro() || gestao();
        allow create, update: if (membro() || gestao())
          && request.resource.data.keys().hasOnly(['nome','resp','em'])
          && str(request.resource.data.nome, 1, 30)
          && request.resource.data.resp in ['vou','talvez','nao']
          && request.resource.data.em == request.time;
        allow delete: if membro() || gestao();
      }
    }
    // Livros sugeridos para o sorteio da leitura oficial (romantasia e fantasia)
    // Abrir/fechar as sugestões: só a administração muda; integrantes leem
    match /config/sugestoes {
      allow read: if membro() || gestao();
      allow write: if gestao()
        && request.resource.data.keys().hasOnly(['aberto','ate','proxima','semeado'])
        && request.resource.data.get('aberto', false) is bool
        && str(request.resource.data.get('ate', ''), 0, 10)
        && str(request.resource.data.get('proxima', ''), 0, 10);
    }
    // LCs extras: cada uma tem a sua lista de sugestões (só a administração cria e muda)
    match /config/lcs {
      allow read: if membro() || gestao();
      allow write: if gestao()
        && request.resource.data.keys().hasOnly(['itens'])
        && request.resource.data.itens is map
        && request.resource.data.itens.size() <= 20;
    }
    function lcAberta(id) {
      let itens = get(/databases/$(database)/documents/config/lcs).data.get('itens', {});
      return id in itens
        && itens[id].get('aberto', false) == true
        && itens[id].get('ativa', true) == true;
    }
    function sugestoesAbertas() {
      return get(/databases/$(database)/documents/config/sugestoes).data.get('aberto', false) == true;
    }
    function livroOk(d) {
      return d.keys().hasOnly(['titulo','autor','genero','obs','nome','uid','status','motivo','criadoEm','lista'])
        && str(d.titulo, 1, 120)
        && str(d.get('autor', ''), 0, 120)
        && str(d.get('lista', 'oficial'), 1, 40)
        && ((d.get('lista', 'oficial') == 'oficial' && d.genero in ['romantasia','fantasia'])
            || (d.get('lista', 'oficial') != 'oficial' && d.genero == ''))
        && str(d.get('obs', ''), 0, 400)
        && str(d.get('nome', ''), 0, 30)
        && str(d.get('motivo', ''), 0, 120)
        && d.status in ['lista','pendente','recusada'];
    }
    match /sugestoes/{id} {
      // integrantes veem a lista e as próprias sugestões; a administração vê tudo
      allow read: if gestao()
        || (membro() && (resource.data.status == 'lista' || resource.data.uid == request.auth.uid));
      allow create: if (gestao() && livroOk(request.resource.data))
        || (membro()
            && (request.resource.data.get('lista', 'oficial') == 'oficial' ? sugestoesAbertas() : lcAberta(request.resource.data.lista))
            && livroOk(request.resource.data)
            && request.resource.data.keys().hasOnly(['titulo','autor','genero','obs','nome','uid','status','criadoEm','lista'])
            && request.resource.data.status == 'pendente'
            && request.resource.data.uid == request.auth.uid
            && str(request.resource.data.nome, 1, 30)
            && str(request.resource.data.autor, 1, 120)
            && request.resource.data.criadoEm == request.time);
      allow update: if gestao() && livroOk(request.resource.data);
      allow delete: if gestao();
    }
    // Lista pública da leitura oficial (página /lista-de-espera): só título, autora e gênero.
    // Qualquer pessoa lê; só a administração grava (a página /livros/admin atualiza sozinha).
    // Nomes de quem sugeriu, observações e status das sugestões não entram aqui.
    match /publico/livros {
      allow read: if true;
      allow write: if gestao()
        && request.resource.data.keys().hasOnly(['itens','em'])
        && request.resource.data.itens is list
        && request.resource.data.itens.size() <= 1000;
    }
    // Ideias de encontros (oficinas e encontros extras): integrantes enviam; só a administração aprova
    match /ideias/{id} {
      // cada aparelho vê só as próprias ideias; a administração vê tudo
      allow read: if gestao() || (membro() && resource.data.uid == request.auth.uid);
      allow create: if membro()
        && request.resource.data.keys().hasOnly(['nome','tipo','titulo','explicacao','organizacao','compromisso','status','uid','criadoEm'])
        && str(request.resource.data.nome, 1, 30)
        && request.resource.data.tipo in ['oficina','extra']
        && str(request.resource.data.titulo, 1, 100)
        && str(request.resource.data.explicacao, 1, 2000)
        && str(request.resource.data.organizacao, 1, 3000)
        && request.resource.data.compromisso == true
        && request.resource.data.status == 'pendente'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.criadoEm == request.time;
      // a administração só muda a situação e o recado
      allow update: if gestao()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','nota'])
        && request.resource.data.status in ['pendente','aprovada','recusada']
        && str(request.resource.data.get('nota', ''), 0, 600);
      allow delete: if gestao();
    }
    // Sugestões para as redes sociais: cada aparelho vê só as próprias; a administração vê tudo
    match /redes/{id} {
      allow read: if gestao() || (membro() && resource.data.uid == request.auth.uid);
      allow create: if membro()
        && request.resource.data.keys().hasOnly(['nome','tipo','descricao','link','imagem','status','uid','criadoEm'])
        && str(request.resource.data.nome, 1, 30)
        && request.resource.data.tipo in ['post','trend','resenha','foto','outro']
        && str(request.resource.data.descricao, 1, 2000)
        && str(request.resource.data.get('link', ''), 0, 500)
        && str(request.resource.data.get('imagem', 'data:image/x;base64,A'), 20, 900000)
        && request.resource.data.get('imagem', 'data:image/x;base64,A').matches('data:image/[a-z]+;base64,[A-Za-z0-9+/=]+')
        && request.resource.data.status == 'recebida'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.criadoEm == request.time;
      // a administração só muda a situação e o recado
      allow update: if gestao()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','nota'])
        && request.resource.data.status in ['recebida','aprovada','publicada']
        && str(request.resource.data.get('nota', ''), 0, 600);
      allow delete: if gestao();
    }
    // Questionário de confirmação de leitura (um por livro do mês; o ID é o mesmo do livro em "leituras")
    match /questionarios/{livro} {
      allow read: if membro() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['perguntas','aberto','minimo','liberado','em'])
        && request.resource.data.perguntas is list
        && request.resource.data.perguntas.size() >= 1 && request.resource.data.perguntas.size() <= 30
        && request.resource.data.aberto is bool
        && request.resource.data.minimo is int && request.resource.data.minimo >= 0 && request.resource.data.minimo <= 100
        && request.resource.data.liberado is list;
      allow delete: if isAdmin();
      // Gabarito: só a administração vê
      match /gabarito/{doc} {
        allow read, write: if isAdmin();
      }
      // Respostas: uma por nome, enviada uma vez só, com o questionário aberto
      match /respostas/{nome} {
        allow list: if isAdmin();
        allow get: if isAdmin()
          || (membro() && (resource == null || resource.data.uid == request.auth.uid));
        allow create: if membro()
          && get(/databases/$(database)/documents/questionarios/$(livro)).data.aberto == true
          && request.resource.data.keys().hasOnly(['nome','r','uid','em'])
          && str(request.resource.data.nome, 1, 30)
          && request.resource.data.r is list
          && request.resource.data.r.size() == get(/databases/$(database)/documents/questionarios/$(livro)).data.perguntas.size()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.em == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
    // Artes do clube: integrantes veem e baixam; só a administração adiciona, muda e apaga.
    // O arquivo fica dividido em partes de até 900 KB (limite do Firestore é 1 MB por documento).
    match /artes/{id} {
      allow read: if membro() || gestao();
      allow create, update: if gestao()
        && request.resource.data.keys().hasOnly(['nome','categoria','tipo','arquivo','tamanho','partes','miniatura','largura','altura','criadoEm'])
        && str(request.resource.data.nome, 1, 100)
        && str(request.resource.data.categoria, 1, 60)
        && str(request.resource.data.tipo, 3, 100)
        && str(request.resource.data.arquivo, 1, 160)
        && request.resource.data.tamanho is int && request.resource.data.tamanho > 0 && request.resource.data.tamanho <= 20000000
        && request.resource.data.partes is int && request.resource.data.partes >= 1 && request.resource.data.partes <= 25
        && (!('miniatura' in request.resource.data) || str(request.resource.data.miniatura, 0, 200000));
      allow delete: if gestao();
      match /partes/{n} {
        allow read: if membro() || gestao();
        allow create, update: if gestao()
          && request.resource.data.keys().hasOnly(['d'])
          && request.resource.data.d is bytes;
        allow delete: if gestao();
      }
    }
    // Votação do livro do mês: a administração cria (3 livros e as datas); integrantes veem
    match /votacoes/{vt} {
      allow read: if membro() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['titulo','opcoes','abre','fecha','encontro','abreEm','fechaEm','criadoEm'])
        && str(request.resource.data.titulo, 1, 80)
        && request.resource.data.opcoes is list && request.resource.data.opcoes.size() == 3
        && request.resource.data.abre.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.encontro.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.abreEm is timestamp
        && request.resource.data.fechaEm is timestamp
        && request.resource.data.abreEm < request.resource.data.fechaEm;
      allow delete: if isAdmin();
      // Votos: um por nome (o ID é o nome), só com a votação aberta, sem trocar depois.
      // Integrantes não leem os votos das outras (o resultado só aparece para a administração).
      match /votos/{nome} {
        allow list: if isAdmin();
        allow get: if isAdmin()
          || (membro() && (resource == null || resource.data.uid == request.auth.uid));
        allow create: if membro()
          && request.time >= get(/databases/$(database)/documents/votacoes/$(vt)).data.abreEm
          && request.time <= get(/databases/$(database)/documents/votacoes/$(vt)).data.fechaEm
          && request.resource.data.keys().hasOnly(['nome','opcao','uid','em'])
          && str(request.resource.data.nome, 1, 30)
          && request.resource.data.opcao is int
          && request.resource.data.opcao >= 0
          && request.resource.data.opcao < get(/databases/$(database)/documents/votacoes/$(vt)).data.opcoes.size()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.em == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
      // Votos presenciais digitados pela administração (só ela vê)
      match /privado/{doc} {
        allow read, write: if isAdmin();
      }
    }
    // Cartas e Teorias Seladas: a administração e o conselho abrem uma rodada (livro, prazo para lacrar e abertura).
    // Cada integrante lacra uma carta no próprio nome. Ninguém lê as cartas das outras antes da abertura, nem a administração.
    match /cartasSeladas/{cs} {
      allow read: if membro() || gestao();
      allow create, update: if gestao()
        && request.resource.data.keys().hasOnly(['titulo','orient','ate','abre','hora','ateEm','abreEm','criadoEm'])
        && str(request.resource.data.titulo, 1, 80)
        && (!('orient' in request.resource.data) || str(request.resource.data.orient, 0, 300))
        && request.resource.data.ateEm is timestamp
        && request.resource.data.abreEm is timestamp;
      allow delete: if gestao();
      match /cartas/{nome} {
        // antes da abertura: só quem escreveu lê a própria carta (ou confere se o nome já lacrou)
        allow get: if (membro() && (resource == null || resource.data.uid == request.auth.uid))
          || ((membro() || gestao()) && request.time >= get(/databases/$(database)/documents/cartasSeladas/$(cs)).data.abreEm);
        allow list: if (membro() || gestao())
          && request.time >= get(/databases/$(database)/documents/cartasSeladas/$(cs)).data.abreEm;
        allow create: if membro()
          && request.time <= get(/databases/$(database)/documents/cartasSeladas/$(cs)).data.ateEm
          && request.time < get(/databases/$(database)/documents/cartasSeladas/$(cs)).data.abreEm
          && request.resource.data.keys().hasOnly(['nome','texto','uid','em'])
          && str(request.resource.data.nome, 1, 30)
          && str(request.resource.data.texto, 1, 2000)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.em == request.time;
        allow update: if false;
        allow delete: if gestao();
      }
      // Selos: só o nome de quem já lacrou (aparece para todas). Criado junto com a carta.
      match /selos/{nome} {
        allow read: if membro() || gestao();
        allow create: if membro()
          && request.resource.data.keys().hasOnly(['nome','em'])
          && str(request.resource.data.nome, 1, 30)
          && request.resource.data.em == request.time
          && existsAfter(/databases/$(database)/documents/cartasSeladas/$(cs)/cartas/$(nome))
          && getAfter(/databases/$(database)/documents/cartasSeladas/$(cs)/cartas/$(nome)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/cartasSeladas/$(cs)/cartas/$(nome)).data.nome == request.resource.data.nome;
        allow update: if false;
        allow delete: if gestao();
      }
    }
    // Limpeza da lista de livros: a administração e o conselho abrem; cada integrante marca os livros que não leria.
    // Integrantes não veem o que as outras marcaram (só a administração e o conselho veem o resultado).
    match /limpezas/{lz} {
      allow read: if membro() || gestao();
      allow create, update: if gestao()
        && request.resource.data.keys().hasOnly(['titulo','ate','fechaEm','min','max','encerrada','criadoEm'])
        && str(request.resource.data.titulo, 1, 80)
        && request.resource.data.ate is string && request.resource.data.ate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.fechaEm is timestamp
        && request.resource.data.min is int && request.resource.data.min >= 1
        && request.resource.data.max is int && request.resource.data.max >= request.resource.data.min && request.resource.data.max <= 50
        && request.resource.data.encerrada is bool;
      allow delete: if gestao();
      function limpezaAberta() {
        let l = get(/databases/$(database)/documents/limpezas/$(lz)).data;
        return l.encerrada == false && request.time <= l.fechaEm;
      }
      function escolhaOk(d) {
        return d.keys().hasOnly(['nome','uid','livros','vistos','pronta','em'])
          && str(d.nome, 1, 30)
          && d.uid == request.auth.uid
          && d.livros is list && d.livros.size() <= get(/databases/$(database)/documents/limpezas/$(lz)).data.max
          && d.vistos is list && d.vistos.size() <= 500
          && d.pronta is bool
          && d.em == request.time;
      }
      // Uma escolha por nome (o ID é o nome). Só o aparelho que começou continua,
      // a não ser que a administração libere para outro aparelho.
      match /escolhas/{nome} {
        allow list: if gestao();
        allow get: if gestao()
          || (membro() && (resource == null || resource.data.uid == request.auth.uid || resource.data.get('liberado', false) == true));
        allow create: if membro() && limpezaAberta() && escolhaOk(request.resource.data);
        allow update: if (membro() && limpezaAberta() && escolhaOk(request.resource.data)
            && (resource.data.uid == request.auth.uid || resource.data.get('liberado', false) == true))
          || (gestao() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liberado'])
            && request.resource.data.liberado == true);
        allow delete: if gestao();
      }
    }
    // Bingo: desafios e abrir/fechar o envio de provas (só a administração muda; integrantes leem)
    match /config/bingo {
      // a tabela só aparece para as integrantes depois que a administração libera
      allow read: if gestao() || (membro() && resource.data.get('visivel', false) == true);
      allow write: if gestao()
        && request.resource.data.keys().hasOnly(['titulo','edicao','desafios','aberto','ate','visivel','resumo','regras'])
        && request.resource.data.get('visivel', false) is bool
        && str(request.resource.data.get('resumo', ''), 0, 3000)
        && str(request.resource.data.get('regras', ''), 0, 9000)
        && str(request.resource.data.titulo, 1, 60)
        && str(request.resource.data.edicao, 1, 40)
        && request.resource.data.desafios is list && request.resource.data.desafios.size() <= 60
        && request.resource.data.aberto is bool
        && str(request.resource.data.ate, 0, 10);
    }
    // Ranking do bingo: só quantos desafios aprovados cada uma tem (a administração atualiza)
    match /config/bingoRanking {
      allow read: if membro() || gestao();
      allow write: if gestao()
        && request.resource.data.keys().hasOnly(['edicao','itens','em'])
        && request.resource.data.itens is map && request.resource.data.itens.size() <= 60;
    }
    function bingo() { return get(/databases/$(database)/documents/config/bingo).data; }
    // Bingo: cada integrante tem a própria cartela. O ID da cartela é um código secreto feito do nome
    // e de 4 números que só ela sabe; sem ele, ninguém abre a cartela (não dá para listar).
    // "pessoas" só diz se o nome já criou o código (para não criarem outro por cima).
    match /pessoas/{nome} {
      allow get: if membro() || gestao();
      allow list: if gestao();
      allow create: if membro()
        && request.resource.data.keys().hasOnly(['em'])
        && request.resource.data.em == request.time;
      allow update: if false;
      allow delete: if gestao();
    }
    match /cartelas/{c} {
      allow get: if membro() || gestao();
      allow list: if gestao();
      // cria junto com "pessoas" (um código por nome)
      allow create: if membro()
        && c.size() == 64
        && request.resource.data.keys().hasOnly(['nome','slug','marcadas','edicao','em'])
        && str(request.resource.data.nome, 1, 30)
        && str(request.resource.data.slug, 1, 40)
        && !exists(/databases/$(database)/documents/pessoas/$(request.resource.data.slug))
        && existsAfter(/databases/$(database)/documents/pessoas/$(request.resource.data.slug))
        && request.resource.data.marcadas is list && request.resource.data.marcadas.size() == 0;
      // a integrante só muda as próprias marcações
      allow update: if membro()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marcadas','edicao','em'])
        && request.resource.data.marcadas is list && request.resource.data.marcadas.size() <= 60
        && str(request.resource.data.edicao, 0, 40);
      allow delete: if gestao();

      // Provas do bingo: a integrante manda o print; só a administração aprova
      match /provas/{id} {
        allow get, list: if membro() || gestao();
        allow create: if membro()
          && bingo().aberto == true
          && bingo().get('visivel', false) == true
          && request.resource.data.keys().hasOnly(['edicao','nome','desafio','desafioTexto','livro','obs','fotos','status','criadoEm'])
          && request.resource.data.edicao == bingo().edicao
          && request.resource.data.nome == get(/databases/$(database)/documents/cartelas/$(c)).data.nome
          && str(request.resource.data.desafio, 1, 40)
          && str(request.resource.data.desafioTexto, 1, 200)
          && str(request.resource.data.get('livro', ''), 0, 120)
          && str(request.resource.data.obs, 0, 400)
          && request.resource.data.fotos is int && request.resource.data.fotos >= 1 && request.resource.data.fotos <= 3
          && request.resource.data.status == 'pendente'
          && request.resource.data.criadoEm == request.time
          && existsAfter(/databases/$(database)/documents/cartelas/$(c)/provas/$(id)/img/0);
        // a administração só muda a situação e o recado
        allow update: if gestao()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','nota'])
          && request.resource.data.status in ['pendente','aprovada','recusada']
          && str(request.resource.data.get('nota', ''), 0, 600);
        // quem mandou pode cancelar enquanto está aguardando
        allow delete: if gestao() || (membro() && resource.data.status == 'pendente');

        // Imagens da prova (separadas, para a lista ficar leve)
        match /img/{n} {
          allow get: if membro() || gestao();
          allow list: if false;
          allow create: if membro() && n == '0'
            && request.resource.data.keys().hasOnly(['imgs'])
            && request.resource.data.imgs is list
            && request.resource.data.imgs.size() == getAfter(/databases/$(database)/documents/cartelas/$(c)/provas/$(id)).data.fotos;
          allow update: if false;
          allow delete: if gestao()
            || (membro() && get(/databases/$(database)/documents/cartelas/$(c)/provas/$(id)).data.status == 'pendente');
        }
      }
    }
    // A administração lê as provas de todas as cartelas de uma vez
    match /{caminho=**}/provas/{id} {
      allow read: if gestao();
    }
    // Arcadiana do Ano: pontos lançados pela administração (um documento por pessoa e por motivo); integrantes veem o ranking
    match /pontos/{id} {
      allow read: if membro() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['nome','ano','tipo','pts','desc','ref','data','lote','fonte','anulado','criadoEm'])
        && str(request.resource.data.nome, 1, 30)
        && request.resource.data.ano is int && request.resource.data.ano >= 2024 && request.resource.data.ano <= 2100
        && request.resource.data.tipo in ['livro','presenca','extra']
        && request.resource.data.pts is int && request.resource.data.pts >= 0 && request.resource.data.pts <= 100
        && str(request.resource.data.desc, 0, 160)
        && str(request.resource.data.get('ref', ''), 0, 200)
        && request.resource.data.data is string && request.resource.data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && str(request.resource.data.get('lote', ''), 0, 40)
        && str(request.resource.data.get('fonte', ''), 0, 20)
        && request.resource.data.get('anulado', false) is bool;
      allow delete: if isAdmin();
    }
    match /arcadiana/{ano} {
      allow read: if membro() || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['sorteio','em'])
        && request.resource.data.sorteio is list && request.resource.data.sorteio.size() <= 40;
    }
    // Conselho: só a administração (Bia) vê a lista, adiciona e tira. O ID do documento é o e-mail Google em minúsculas.
    // Cada conselheira só consegue conferir o próprio documento (para o site saber que ela tem acesso).
    match /conselho/{email} {
      allow get: if isAdmin()
        || (request.auth != null && request.auth.token.get('email', '') is string
            && request.auth.token.get('email', '').lower() == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && email.matches('^[^@/ ]+@[^@/ ]+[.][^@/ ]+$') && email == email.lower()
        && request.resource.data.keys().hasOnly(['nome','em'])
        && str(request.resource.data.get('nome', ''), 0, 40);
      allow delete: if isAdmin();
    }
    // Administradoras (documento criado à mão no console do Firebase)
    // Fale com a administração: só a administração principal lê. Sem nome = sem nome e sem aparelho guardados.
    match /mensagens/{id} {
      allow read: if isAdmin() || (membro() && resource.data.get('uid', '') == request.auth.uid);
      allow create: if membro()
        && request.resource.data.keys().hasOnly(['tipo','texto','nome','uid','lida','criadoEm'])
        && request.resource.data.tipo in ['elogio','reclamacao','problema','outro']
        && str(request.resource.data.texto, 1, 3000)
        && request.resource.data.lida == false
        && request.resource.data.criadoEm == request.time
        && ((!('nome' in request.resource.data) && !('uid' in request.resource.data))
          || (str(request.resource.data.get('nome', ''), 1, 30) && request.resource.data.get('uid', '') == request.auth.uid));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida','resposta'])
        && request.resource.data.lida is bool
        && str(request.resource.data.get('resposta', ''), 0, 1500);
      allow delete: if isAdmin();
    }
    // Código da Sociedade Arcádia: só integrantes leem; só a administração principal publica
    match /codigo/{doc} {
      allow read: if membro() || isAdmin();
      allow write: if isAdmin() && doc == 'atual'
        && request.resource.data.keys().hasOnly(['texto','edicao','em'])
        && str(request.resource.data.texto, 1, 60000)
        && str(request.resource.data.get('edicao', ''), 0, 40)
        && request.resource.data.em == request.time;
    }
    // Formulário de ingresso (link que a administração manda para quem entra no clube): qualquer pessoa envia;
    // administração e conselho leem (dados pessoais, só uso interno); só a administração apaga
    match /ingressos/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['nome','apelido','nascimento','whatsapp','instagram','email','endereco',
             'generos','favoritos','cinco','ritmo','abandona','formato','picante','evita','motivo','valer','origem',
             'encontros','horarios','alergia','imagem','confirmacoes','extra','criadoEm'])
        && str(request.resource.data.nome, 3, 120)
        && str(request.resource.data.apelido, 1, 40)
        && str(request.resource.data.nascimento, 10, 10)
        && str(request.resource.data.whatsapp, 10, 20)
        && str(request.resource.data.instagram, 2, 60)
        && str(request.resource.data.email, 5, 120)
        && request.resource.data.endereco is map
        && request.resource.data.endereco.keys().hasOnly(['cep','rua','numero','complemento','bairro','cidade','referencia'])
        && str(request.resource.data.endereco.cep, 1, 12)
        && str(request.resource.data.endereco.rua, 1, 140)
        && str(request.resource.data.endereco.numero, 1, 12)
        && str(request.resource.data.endereco.get('complemento', ''), 0, 80)
        && str(request.resource.data.endereco.bairro, 1, 80)
        && str(request.resource.data.endereco.cidade, 1, 80)
        && str(request.resource.data.endereco.get('referencia', ''), 0, 140)
        && request.resource.data.generos is list && request.resource.data.generos.size() >= 1 && request.resource.data.generos.size() <= 15
        && str(request.resource.data.favoritos, 1, 1000)
        && str(request.resource.data.cinco, 1, 160)
        && str(request.resource.data.ritmo, 1, 40)
        && str(request.resource.data.abandona, 1, 40)
        && request.resource.data.formato is list && request.resource.data.formato.size() <= 5
        && str(request.resource.data.picante, 1, 60)
        && str(request.resource.data.get('evita', ''), 0, 600)
        && str(request.resource.data.motivo, 1, 1500)
        && str(request.resource.data.valer, 1, 1500)
        && str(request.resource.data.origem, 1, 60)
        && str(request.resource.data.encontros, 1, 40)
        && request.resource.data.horarios is list && request.resource.data.horarios.size() <= 10
        && str(request.resource.data.get('alergia', ''), 0, 300)
        && request.resource.data.imagem is bool
        && request.resource.data.confirmacoes is list && request.resource.data.confirmacoes.size() <= 6
        && str(request.resource.data.get('extra', ''), 0, 1500)
        && request.resource.data.criadoEm == request.time;
      allow read: if gestao();
      allow delete: if isAdmin();
      allow update: if false;
    }
    // ================= Lista de desejos e Mural de aniversário =================
    // Cada integrante tem a lista pelo nome (desejos/{nome}), protegida por um código de 4 números que ela mesma cria.
    // O código fica embaralhado (SHA-256) no campo pin. Cada aparelho que digita o código certo ganha desejosAcesso/{uid}.
    // A lista só é lida pela dona e pela administração principal (Bia; o conselho não vê).
    // O mural (aniversarios) e as datas (aniversariosDatas) todas as integrantes veem.
    function desDoc(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    function desDonaAgora(nome) {
      return request.auth != null
        && exists(desDoc('desejosAcesso', request.auth.uid))
        && exists(desDoc('desejos', nome))
        && get(desDoc('desejosAcesso', request.auth.uid)).data.nome == nome
        && get(desDoc('desejosAcesso', request.auth.uid)).data.prova == get(desDoc('desejos', nome)).data.pin;
    }
    function desDonaDepois(nome) {
      return request.auth != null
        && existsAfter(desDoc('desejosAcesso', request.auth.uid))
        && getAfter(desDoc('desejosAcesso', request.auth.uid)).data.nome == nome
        && getAfter(desDoc('desejosAcesso', request.auth.uid)).data.prova == getAfter(desDoc('desejos', nome)).data.pin;
    }
    function desOk(d) {
      return d.keys().hasOnly(['nome','pin','livros','especiais','recado','em'])
        && str(d.nome, 1, 30)
        && str(d.pin, 64, 64)
        && d.livros is list && d.livros.size() <= 200
        && d.especiais is list && d.especiais.size() <= 100
        && str(d.get('recado', ''), 0, 2000)
        && d.em == request.time;
    }
    match /desejos/{nome} {
      allow get: if isAdmin() || (membro() && (resource == null || desDonaAgora(nome)));
      allow list: if isAdmin();
      allow create: if membro() && desOk(request.resource.data) && desDonaDepois(nome);
      allow update: if (membro() && desDonaAgora(nome) && desOk(request.resource.data) && desDonaDepois(nome))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin'])
            && str(request.resource.data.pin, 64, 64));
      allow delete: if isAdmin();
    }
    // Aparelho liberado: só com o código certo (a versão embaralhada tem que ser igual à da lista)
    match /desejosAcesso/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if membro() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome','prova','em'])
        && str(request.resource.data.nome, 1, 40)
        && str(request.resource.data.prova, 64, 64)
        && existsAfter(desDoc('desejos', request.resource.data.nome))
        && getAfter(desDoc('desejos', request.resource.data.nome)).data.pin == request.resource.data.prova;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /aniversarios/{nome} {
      allow read: if membro() || isAdmin();
      allow create, update: if membro() && desDonaAgora(nome)
        && request.resource.data.keys().hasOnly(['nome','amazon','links','em'])
        && str(request.resource.data.nome, 1, 30)
        && str(request.resource.data.get('amazon', ''), 0, 600)
        && request.resource.data.get('links', []) is list && request.resource.data.get('links', []).size() <= 12
        && request.resource.data.em == request.time;
      allow delete: if isAdmin() || (membro() && desDonaAgora(nome));
    }
    match /aniversariosDatas/{doc} {
      allow read: if membro() || isAdmin();
      allow write: if isAdmin() && doc == 'lista'
        && request.resource.data.keys().hasOnly(['datas','em'])
        && request.resource.data.datas is map && request.resource.data.datas.size() <= 60;
    }
    // ================= Salão Principal de Hogwarts (LC Especial de Natal 2026) =================
    // Entrar exige: senha do clube (membro) + senha do Salão + código pessoal de cada participante.
    // Senha e códigos ficam embaralhados (SHA-256) como ID de documento; ninguém lê pelo site.
    function hgDoc(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    function hgSes() { return get(hgDoc('hgSessoes', request.auth.uid)).data; }
    function hg() {
      return request.auth != null
        && exists(hgDoc('hgSessoes', request.auth.uid))
        && exists(hgDoc('hgChave', hgSes().senha))
        && exists(hgDoc('hgCodigos', hgSes().cod));
    }
    function hgPid() { return hgSes().pid; }
    function hgNome() { return get(hgDoc('hgPessoas', hgSes().pid)).data.nome; }
    function hgData(k) { return get(hgDoc('hgConfig', 'datas')).data.get(k, 0); }
    // a atividade já abriu (k) e ainda não fechou (f; '' = sem prazo)
    function hgAberto(k, f) {
      return request.time.toMillis() >= hgData(k)
        && (f == '' || request.time.toMillis() <= hgData(f));
    }
    function hgCasa(c) { return c in ['grifinoria', 'sonserina', 'corvinal', 'lufalufa']; }
    function hgPersonagem(p) { return p in ['harry', 'hermione', 'rony', 'draco', 'neville', 'hagrid', 'snape', 'dumbledore',
      'minerva', 'quirrell', 'valter', 'petunia', 'duda', 'gemeos', 'percy', 'olivio', 'filch', 'firenze']; }
    // Primeiros Mistérios: a rodada também abre para quem marcou que terminou o último capítulo dela (hgLido)
    function hgLeuAte(r) {
      return exists(hgDoc('hgLido', hgPid()))
        && get(hgDoc('hgLido', hgPid())).data.cap >= {'r1': 4, 'r2': 7, 'r3': 12, 'r4': 17}.get(r, 99);
    }
    function hgRodadaAberta(r, f) {
      return hgAberto(r, f)
        || (hgLeuAte(r) && (f == '' || request.time.toMillis() <= hgData(f)));
    }

    // Senha do Salão: ID = SHA-256 da senha. Só a administração cria e troca.
    match /hgChave/{h} {
      allow get: if false;
      allow list, delete: if isAdmin();
      allow create: if isAdmin() && h.matches('^[0-9a-f]{64}$') && request.resource.data.keys().hasOnly(['em']);
    }
    // Código pessoal: ID = SHA-256 do código; guarda de quem é
    match /hgCodigos/{h} {
      allow get: if false;
      allow list, delete: if isAdmin();
      allow create: if isAdmin() && h.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['pid']) && str(request.resource.data.pid, 1, 40);
    }
    // Participantes cadastradas pela administração
    match /hgPessoas/{pid} {
      allow read: if hg() || isAdmin();
      allow write: if isAdmin() && pid.matches('^[a-z0-9-]{1,40}$')
        && request.resource.data.keys().hasOnly(['nome', 'em'])
        && str(request.resource.data.nome, 1, 30);
      allow delete: if isAdmin();
    }
    // Código de cada participante em texto, para a administração mandar para ela (só a administração lê)
    match /hgPrivado/{pid} { allow read, write: if isAdmin(); }
    // Aparelho que entrou no Salão: precisa da senha do clube, da senha do Salão e de um código pessoal válido
    match /hgSessoes/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create, update: if membro() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['senha', 'cod', 'pid', 'em'])
        && request.resource.data.senha is string && request.resource.data.cod is string
        && request.resource.data.pid is string && request.resource.data.em is int
        && exists(hgDoc('hgChave', request.resource.data.senha))
        && get(hgDoc('hgCodigos', request.resource.data.cod)).data.pid == request.resource.data.pid;
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }
    // Configurações (datas de liberação, tempos, sala de vídeo, links): participantes leem, administração edita
    match /hgConfig/{doc} {
      allow read: if hg() || isAdmin();
      allow write: if isAdmin();
    }
    // Perfil: casa de Hogwarts informada pela própria participante
    match /hgPerfis/{pid} {
      allow read: if hg() || isAdmin();
      allow create, update: if hg() && pid == hgPid()
        && request.resource.data.keys().hasOnly(['nome', 'casa', 'em'])
        && request.resource.data.nome == hgNome() && hgCasa(request.resource.data.casa)
        && request.resource.data.em is int;
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['nome', 'casa', 'em'])
        && str(request.resource.data.nome, 1, 30) && hgCasa(request.resource.data.casa);
      allow delete: if isAdmin();
    }
    // Chapéu Seletor: cada participante sorteia uma vez; cada personagem só sai uma vez.
    // O aparelho grava os dois documentos juntos (lote); se outra pessoa pegou o mesmo personagem, o lote falha e o site sorteia de novo.
    match /hgSorteio/{pid} {
      allow get: if (hg() && pid == hgPid()) || isAdmin();
      allow list: if isAdmin();
      allow create: if hg() && pid == hgPid() && hgAberto('chapeu', '')
        && exists(hgDoc('hgPerfis', pid))
        && request.resource.data.keys().hasOnly(['personagem', 'em'])
        && hgPersonagem(request.resource.data.personagem) && request.resource.data.em is int
        && !exists(hgDoc('hgPersonagens', request.resource.data.personagem))
        && existsAfter(hgDoc('hgPersonagens', request.resource.data.personagem));
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['personagem', 'em'])
        && hgPersonagem(request.resource.data.personagem) && request.resource.data.em is int;
      allow delete: if isAdmin();
    }
    // Personagens já sorteados (sem dizer para quem): o ID é o personagem
    match /hgPersonagens/{p} {
      allow read: if hg() || isAdmin();
      allow create: if hg() && hgPersonagem(p)
        && request.resource.data.keys().hasOnly(['em']) && request.resource.data.em is int
        && !exists(hgDoc('hgSorteio', hgPid()))
        && getAfter(hgDoc('hgSorteio', hgPid())).data.personagem == p;
      allow write, delete: if isAdmin();
    }

    // ----- Biblioteca de Hogwarts (sprints): separada da sala geral -----
    // Ranking da LC: um documento por participante (vale em qualquer aparelho)
    match /hgLeitoras/{pid} {
      allow read: if hg() || isAdmin();
      allow write: if hg() && pid == hgPid()
        && request.resource.data.keys().hasOnly(['nome', 'min', 'sprints', 'livro', 'atualizado'])
        && request.resource.data.nome == hgNome()
        && request.resource.data.min is int && request.resource.data.min >= 0 && request.resource.data.min <= 100000
        && request.resource.data.sprints is int
        && str(request.resource.data.livro, 0, 80) && request.resource.data.atualizado is string;
      allow write, delete: if isAdmin();
    }
    // Histórico de sessões de cada participante (só ela e a administração leem)
    match /hgLog/{id} {
      allow read: if (hg() && resource.data.pid == hgPid()) || isAdmin();
      allow create: if hg() && request.resource.data.pid == hgPid()
        && request.resource.data.keys().hasOnly(['pid', 't', 'min', 'livro', 'pags', 'coletivo'])
        && request.resource.data.t is int
        && request.resource.data.min is int && request.resource.data.min >= 1 && request.resource.data.min <= 720
        && str(request.resource.data.livro, 0, 80)
        && request.resource.data.pags is int && request.resource.data.coletivo is bool;
      allow delete: if (hg() && resource.data.pid == hgPid()) || isAdmin();
      allow update: if false;
    }
    match /hgSalaUso/{mes} {
      allow read: if hg() || isAdmin();
      allow create: if hg() && request.resource.data.keys().hasOnly(['min'])
        && request.resource.data.min is int && request.resource.data.min >= 0 && request.resource.data.min <= 10;
      allow update: if hg() && request.resource.data.keys().hasOnly(['min'])
        && request.resource.data.min is int && request.resource.data.min >= resource.data.min
        && request.resource.data.min <= resource.data.min + 10;
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['min'])
        && request.resource.data.min is int && request.resource.data.min >= 0;
    }
    // Sprint coletivo da Biblioteca: organização (antes de startAt), leituras, pausa longa entre leituras e prosa final
    match /hgColetivo/atual {
      allow read: if hg() || isAdmin();
      allow write: if hg()
        && request.resource.data.keys().hasOnly(['startAt', 'read', 'prosa', 'pausa', 'ciclos', 'por', 'dono', 'livre', 'fim'])
        && request.resource.data.startAt is int
        && request.resource.data.read is int && request.resource.data.read >= 1 && request.resource.data.read <= 180
        && request.resource.data.prosa is int && request.resource.data.prosa >= 0 && request.resource.data.prosa <= 60
        && request.resource.data.get('pausa', 0) is int && request.resource.data.get('pausa', 0) >= 0 && request.resource.data.get('pausa', 0) <= 60
        && request.resource.data.get('ciclos', 1) is int
        && request.resource.data.get('ciclos', 1) >= 1 && request.resource.data.get('ciclos', 1) <= 12
        && str(request.resource.data.por, 0, 30)
        && request.resource.data.dono == request.auth.uid
        && (resource == null
            || resource.data.dono == request.auth.uid
            || resource.data.startAt + (resource.data.read + resource.data.get('pausa', resource.data.prosa) + resource.data.prosa) * 60000 * resource.data.get('ciclos', 1) < request.time.toMillis()
            || resource.data.get('fim', 9000000000000000) < request.time.toMillis());
      allow update: if hg()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fim'])
        && request.resource.data.fim is int && request.resource.data.fim <= request.time.toMillis() + 60000;
      allow write: if isAdmin();
    }
    match /hgColetivo/atual/quem/{uid} {
      allow read: if hg() || isAdmin();
      allow delete: if isAdmin();
      allow write: if hg() && request.auth.uid == uid
        && (request.resource == null || request.resource.data.get('nome', hgNome()) == hgNome());
    }
    match /hgColetivoLido/{id} {
      allow read, delete: if isAdmin();
      allow create: if hg() && request.resource.data.keys().hasOnly(['nome', 'uid', 'min', 'startAt', 'em'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nome == hgNome()
        && request.resource.data.min is int && request.resource.data.min >= 1 && request.resource.data.min <= 720
        && request.resource.data.startAt is int && request.resource.data.em is int;
      allow update: if false;
    }
    match /hgOnline/{uid} {
      allow read: if hg() || isAdmin();
      allow delete: if hg() && request.auth.uid == uid;
      allow create, update: if hg() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'em', 'modo', 'ate'])
        && request.resource.data.nome == hgNome()
        && request.resource.data.em is int && request.resource.data.ate is int
        && request.resource.data.modo in ['site', 'lendo', 'coletivo'];
    }
    match /hgChamados/{id} {
      allow read: if hg() && resource.data.para == request.auth.uid;
      allow create: if hg() && request.resource.data.keys().hasOnly(['de', 'deUid', 'para', 'texto', 'em'])
        && request.resource.data.deUid == request.auth.uid
        && request.resource.data.de == hgNome()
        && str(request.resource.data.para, 1, 128)
        && str(request.resource.data.texto, 0, 140)
        && request.resource.data.em is int;
      allow delete: if hg() && (resource.data.para == request.auth.uid || resource.data.deUid == request.auth.uid);
      allow update: if false;
    }
    // Chat da Biblioteca: fica guardado (funciona com ou sem sprint). cap = capítulo do spoiler (mensagem escondida até tocar)
    match /hgChat/{id} {
      allow read: if hg() || isAdmin();
      allow create: if hg() && request.resource.data.keys().hasOnly(['pid', 'nome', 'texto', 'em', 'fig', 'cap'])
        && request.resource.data.pid == hgPid() && request.resource.data.nome == hgNome()
        && str(request.resource.data.texto, 1, 500) && request.resource.data.em is int
        && (!('fig' in request.resource.data) || (request.resource.data.fig is string && request.resource.data.fig.matches('^[A-Za-z0-9_-]{1,40}$')))
        && (!('cap' in request.resource.data) || (request.resource.data.cap is int && request.resource.data.cap >= 1 && request.resource.data.cap <= 17));
      allow delete: if (hg() && resource.data.pid == hgPid()) || isAdmin();
      allow update: if false;
    }
    // Sprints coletivos agendados (datas e horários pela administração) + confirmação de presença
    match /hgEncontros/{id} {
      allow read: if hg() || isAdmin();
      allow write: if isAdmin();
      match /presencas/{pid} {
        allow read: if hg() || isAdmin();
        allow write: if hg() && pid == hgPid()
          && request.resource.data.keys().hasOnly(['nome', 'vai', 'em'])
          && request.resource.data.nome == hgNome() && request.resource.data.vai is bool
          && request.resource.data.em is int;
        allow delete: if (hg() && pid == hgPid()) || isAdmin();
      }
    }
    // Figurinhas exclusivas da Biblioteca (imagem pequena guardada no próprio documento)
    match /hgFigurinhas/{id} {
      allow read: if hg() || isAdmin();
      allow write: if isAdmin();
    }
    // ----- Primeiros Mistérios (r1..r4) e As Sete Proteções (protecoes) -----
    // Perguntas: a participante só lê a rodada depois da data de liberação
    match /hgQuiz/{rodada} {
      allow read: if isAdmin() || (hg() && rodada in ['r1', 'r2', 'r3', 'r4', 'protecoes'] && hgRodadaAberta(rodada, ''));
      allow write: if isAdmin();
    }
    // Até qual capítulo cada uma já leu (ela mesma marca; abre as rodadas daquele trecho)
    match /hgLido/{pid} {
      allow read: if isAdmin() || (hg() && pid == hgPid());
      allow create, update: if hg() && pid == hgPid()
        && request.resource.data.keys().hasOnly(['cap', 'em'])
        && request.resource.data.cap is int && request.resource.data.cap >= 0 && request.resource.data.cap <= 17
        && request.resource.data.em is int;
      allow delete: if isAdmin();
    }
    // Progresso de cada uma (ID = pid_rodada); sem ranking
    match /hgProgresso/{id} {
      allow read: if isAdmin() || (hg() && resource.data.pid == hgPid());
      allow create, update: if hg() && request.resource.data.pid == hgPid()
        && request.resource.data.keys().hasOnly(['pid', 'rodada', 'atual', 'feito', 'vezes', 'em'])
        && request.resource.data.rodada in ['r1', 'r2', 'r3', 'r4', 'protecoes']
        && id == hgPid() + '_' + request.resource.data.rodada
        && hgRodadaAberta(request.resource.data.rodada, request.resource.data.rodada == 'protecoes' ? 'protecoesFim' : 'misteriosFim')
        && request.resource.data.atual is int && request.resource.data.atual >= 0 && request.resource.data.atual <= 20
        && request.resource.data.feito is bool && request.resource.data.vezes is int && request.resource.data.em is int;
      allow delete: if isAdmin();
    }
    // ----- Mistérios: cada resposta vale uma vez só (sem trocar depois) + porcentagem anônima de acertos -----
    function hgEstDoc(id) { return hgDoc('hgEstat', id); }
    function hgEstN(id) { return exists(hgEstDoc(id)) ? get(hgEstDoc(id)).data.n : 0; }
    match /hgRespostas/{id} {
      allow read: if isAdmin() || (hg() && resource.data.pid == hgPid());
      allow create: if hg()
        && request.resource.data.keys().hasOnly(['pid', 'nome', 'rodada', 'i', 'k', 'certa', 'em'])
        && request.resource.data.pid == hgPid()
        && request.resource.data.nome == hgNome()
        && request.resource.data.rodada in ['r1', 'r2', 'r3', 'r4']
        && request.resource.data.i is int && request.resource.data.i >= 0 && request.resource.data.i < 20
        && id == hgPid() + '_' + request.resource.data.rodada + '_' + string(request.resource.data.i)
        && request.resource.data.k is int && request.resource.data.k >= 0 && request.resource.data.k <= 3
        && hgRodadaAberta(request.resource.data.rodada, 'misteriosFim')
        && request.resource.data.certa == (get(hgDoc('hgQuiz', request.resource.data.rodada)).data.perguntas[request.resource.data.i].c == request.resource.data.k)
        && request.resource.data.em is int
        && getAfter(hgEstDoc(request.resource.data.rodada + '_' + string(request.resource.data.i))).data.n == hgEstN(request.resource.data.rodada + '_' + string(request.resource.data.i)) + 1;
      allow update: if false;
      allow delete: if isAdmin();
    }
    // contagem anônima por pergunta: só sobe junto com uma resposta nova da própria participante
    match /hgEstat/{id} {
      allow read: if hg() || isAdmin();
      allow create, update: if hg()
        && request.resource.data.keys().hasOnly(['n', 'certas'])
        && !exists(hgDoc('hgRespostas', hgPid() + '_' + id))
        && existsAfter(hgDoc('hgRespostas', hgPid() + '_' + id))
        && request.resource.data.n == (resource == null ? 0 : resource.data.n) + 1
        && request.resource.data.certas == (resource == null ? 0 : resource.data.certas) + (getAfter(hgDoc('hgRespostas', hgPid() + '_' + id)).data.certa ? 1 : 0);
      allow write: if isAdmin();
    }
    // ----- Questionário oficial da LC (separado dos jogos): uma resposta por pessoa, até o prazo -----
    match /hgQuestionario/{q} {
      allow read: if hg() || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['perguntas', 'aberto', 'em'])
        && request.resource.data.perguntas is list
        && request.resource.data.perguntas.size() >= 1 && request.resource.data.perguntas.size() <= 30
        && request.resource.data.aberto is bool;
      allow delete: if isAdmin();
      match /gabarito/{doc} {
        allow read, write: if isAdmin();
      }
      match /respostas/{pid} {
        allow list: if isAdmin();
        allow get: if isAdmin() || (hg() && pid == hgPid());
        allow create: if hg() && pid == hgPid()
          && get(/databases/$(database)/documents/hgQuestionario/$(q)).data.aberto == true
          && request.time.toMillis() <= hgData('questionarioFim')
          && request.resource.data.keys().hasOnly(['nome', 'r', 'uid', 'em'])
          && request.resource.data.nome == hgNome()
          && request.resource.data.r is list
          && request.resource.data.r.size() == get(/databases/$(database)/documents/hgQuestionario/$(q)).data.perguntas.size()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.em == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
    // ----- Espelho de Ojesed: uma participação por pessoa, editável até o prazo -----
    match /hgEspelho/{pid} {
      allow read: if isAdmin() || (hg() && pid == hgPid());
      allow create, update: if hg() && pid == hgPid() && hgAberto('espelho', 'espelhoFim')
        && request.resource.data.keys().hasOnly(['nome', 'lembranca', 'desejo', 'compartilhar', 'em'])
        && request.resource.data.nome == hgNome()
        && str(request.resource.data.lembranca, 1, 3000) && str(request.resource.data.desejo, 1, 3000)
        && request.resource.data.compartilhar is bool && request.resource.data.em is int;
      // a administração organiza (marca a ordem de leitura no encontro)
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ordem', 'lida']);
      allow delete: if isAdmin();
    }
    // ----- Correio-Coruja -----
    // Etapa 1: carta de expectativas (uma por pessoa, editável até o prazo)
    match /hgCartas/{pid} {
      allow read: if isAdmin() || (hg() && pid == hgPid());
      allow create, update: if hg() && pid == hgPid() && hgAberto('correio', 'correioFim')
        && request.resource.data.keys().hasOnly(['nome', 'r1', 'r2', 'r3', 'r4', 'em'])
        && request.resource.data.nome == hgNome()
        && str(request.resource.data.r1, 0, 2000) && str(request.resource.data.r2, 0, 2000)
        && str(request.resource.data.r3, 0, 2000) && str(request.resource.data.r4, 0, 2000)
        && request.resource.data.em is int;
      allow delete: if isAdmin();
    }
    // Etapa 2: impressões depois do primeiro episódio (abre no horário que a administração definir)
    match /hgCoruja/{pid} {
      allow read: if isAdmin() || (hg() && pid == hgPid());
      allow create, update: if hg() && pid == hgPid() && hgData('coruja') > 0 && hgAberto('coruja', 'corujaFim')
        && request.resource.data.keys().hasOnly(['nome', 'r1', 'r2', 'r3', 'r4', 'em'])
        && request.resource.data.nome == hgNome()
        && str(request.resource.data.r1, 0, 2000) && str(request.resource.data.r2, 0, 2000)
        && str(request.resource.data.r3, 0, 2000) && str(request.resource.data.r4, 0, 2000)
        && request.resource.data.em is int;
      allow delete: if isAdmin();
    }
    // Comentários sobre a série (só depois da abertura da etapa 2); resp = ID da mensagem respondida
    match /hgComentarios/{id} {
      allow read: if isAdmin() || (hg() && hgData('coruja') > 0 && hgAberto('coruja', ''));
      allow create: if hg() && hgData('coruja') > 0 && hgAberto('coruja', 'corujaFim')
        && request.resource.data.keys().hasOnly(['pid', 'nome', 'texto', 'resp', 'em'])
        && request.resource.data.pid == hgPid() && request.resource.data.nome == hgNome()
        && str(request.resource.data.texto, 1, 1500) && str(request.resource.data.resp, 0, 40)
        && request.resource.data.em is int;
      allow delete: if isAdmin() || (hg() && resource.data.pid == hgPid());
      allow update: if false;
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
